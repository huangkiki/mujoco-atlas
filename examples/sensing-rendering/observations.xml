<mujoco model="native_observation_contracts">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <statistic extent="2"/>
  <visual>
    <global offwidth="64" offheight="48"/>
    <map znear="0.01" zfar="5"/>
  </visual>
  <worldbody>
    <light pos="1 -1 2"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.4 0.4 0.4 1"/>
    <body name="camera_mount" pos="0 0 1.4">
      <camera name="top" quat="1 0 0 0" fovy="50" resolution="64 48"/>
    </body>
    <body name="payload" pos="0.1 0 0.4">
      <freejoint/>
      <geom name="ball" type="sphere" size="0.1" mass="0.2" rgba="0.8 0.2 0.1 1"/>
      <site name="imu" size="0.008"/>
    </body>
  </worldbody>
  <sensor>
    <gyro name="angular_velocity" site="imu"/>
    <accelerometer name="specific_force" site="imu"/>
    <framepos name="imu_in_camera" objtype="site" objname="imu"
              reftype="camera" refname="top"/>
    <camprojection name="imu_pixel" site="imu" camera="top"/>
    <rangefinder name="rays" camera="top" data="dist point depth"/>
  </sensor>
</mujoco>
